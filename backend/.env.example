NOCODEML_HOST=0.0.0.0
NOCODEML_PORT=8000
NOCODEML_ENVIRONMENT=development
NOCODEML_LOG_LEVEL=INFO
NOCODEML_AUTO_CREATE_TABLES=true
NOCODEML_RUN_MIGRATIONS_ON_STARTUP=false
NOCODEML_METRICS_ENABLED=true
NOCODEML_MAX_TRAINING_WORKERS=2
NOCODEML_EXECUTION_BACKEND=celery
NOCODEML_DATABASE_URL=postgresql+psycopg://nocodeml:nocodeml@localhost:5432/nocodeml
NOCODEML_REDIS_URL=redis://localhost:6379/0
NOCODEML_CELERY_BROKER_URL=redis://localhost:6379/0
NOCODEML_CELERY_RESULT_BACKEND=redis://localhost:6379/1
NOCODEML_CELERY_QUEUE=training
NOCODEML_CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=3600
NOCODEML_CELERY_TASK_TIME_LIMIT_SECONDS=3900
NOCODEML_CELERY_WORKER_PREFETCH_MULTIPLIER=1
NOCODEML_ARTIFACTS_ROOT=artifacts
NOCODEML_MODELS_ROOT=artifacts/models
NOCODEML_REGISTRY_ROOT=artifacts/registry
